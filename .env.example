LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Agent Smith ─────────────────────────────────────────────────────────────
# Diese Werte gehören NUR in .env.local (nie ins öffentliche Repo).
# Jeder Wert kann pro Betrieb überschrieben werden: SMITH_<PROFIL>_<NAME>,
# z. B. SMITH_FRISEUR_SCHNITTPUNKT_NTFY_THEMA=...

# Standardprofil, falls die angerufene Nummer keinem Profil zugeordnet ist
SMITH_PROFIL=

# Push aufs Handy: ntfy-App installieren und dieses Thema abonnieren.
# Das Thema wirkt wie ein Passwort – lang und zufällig wählen.
SMITH_NTFY_THEMA=
SMITH_NTFY_SERVER=https://ntfy.sh
SMITH_NTFY_TOKEN=

# E-Mail (mehrere Empfänger mit Komma trennen)
SMITH_EMAIL_AN=
SMITH_SMTP_SERVER=
SMITH_SMTP_PORT=587
SMITH_SMTP_BENUTZER=
SMITH_SMTP_PASSWORT=
SMITH_SMTP_ABSENDER=

# Webhook (n8n, Make, Zapier …)
SMITH_WEBHOOK_URL=
